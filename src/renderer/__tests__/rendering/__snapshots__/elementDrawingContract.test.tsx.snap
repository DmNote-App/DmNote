      "--dmn-key-bg-default": "#112233",
      "--dmn-key-bg-image-default": "none",
      "--dmn-key-border-default": "none",
      "--dmn-key-font-family-default": "inherit",
      "--dmn-key-font-size-default": "12px",
      "--dmn-key-font-style-default": "normal",
      "--dmn-key-font-weight-default": "700",
      "--dmn-key-label-color-default": "inherit",
      "--dmn-key-padding-default": "2px",
      "--dmn-key-radius-default": "6px",
      "--dmn-key-shadow-default": "1px 2px 3px #000000",
      "--dmn-key-text-color-default": "rgba(237, 238, 242, 0.78)",
      "--dmn-key-text-decoration-default": "none",
      "--dmn-key-text-image-default": "none",
      "--dmn-key-text-repeat-default": "repeat",
      "backface-visibility": "visible",
      "box-sizing": "border-box",
      "contain": "layout style",
      "height": "60px",
      "image-rendering": "auto",
      "isolation": "isolate",
      "transform": "translate(calc(0px + var(--key-offset-x, 0px)), calc(0px + var(--key-offset-y, 0px)))",
      "transform-style": "flat",
      "width": "60px",
      "will-change": "auto",
      "z-index": "0",
    },
  },
]
`;
